                <div class="mt-0.5 flex items-baseline gap-2">
                  <span class="font-mono text-[18px] font-semibold tabular-nums ${this.state.approvals.length > 0 ? 'text-amber-700' : 'text-slate-900'}">${this.state.approvals.length}</span>
                  <span class="text-[11px] text-slate-500">blocked on policy gate</span>
                </div>
              </div>
              <div class="bg-white border border-slate-200 rounded-md px-3.5 py-2.5">
                <div class="text-[11px] font-medium text-slate-500">Flagged (>=5 Errors)</div>
                <div class="mt-0.5 flex items-baseline gap-2">
                  <span class="font-mono text-[18px] font-semibold tabular-nums ${flaggedCount > 0 ? 'text-red-700' : 'text-slate-900'}">${flaggedCount}</span>
                  <span class="text-[11px] text-slate-500">auto-clears on recovery</span>
                </div>
              </div>
              <div class="bg-white border border-slate-200 rounded-md px-3.5 py-2.5">
                <div class="text-[11px] font-medium text-slate-500">24h Fleet Spend</div>
                <div class="mt-0.5 flex items-baseline gap-2">
                  <span class="font-mono text-[18px] font-semibold text-slate-900 tabular-nums">$${totalBudgetUsed.toFixed(2)}</span>
                  <span class="font-mono text-[11px] text-slate-500">/ $${totalBudgetCap.toFixed(2)} cap</span>
                </div>
              </div>
            </div>

            <!-- Filter Bar -->
            <div class="bg-white border border-slate-200 rounded-md p-2.5 flex flex-col md:flex-row md:items-center justify-between gap-2.5">
              <div class="relative flex-1 max-w-md">
                <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
                <input
                  id="fleet-search-input"
                  type="text"
                  value="${esc(this.state.searchQuery)}"
                  oninput="app.setSearchQuery(this.value)"
                  placeholder="Filter by agent ID, trigger, or last wake outcome..."
                  class="w-full pl-8 pr-3 py-1.5 rounded border border-slate-200 bg-slate-50 focus:bg-white focus:border-slate-400 focus:outline-none text-[12px] text-slate-900"
                />
              </div>
              <div class="flex items-center gap-1 flex-wrap">
                ${quickStates.map(st => {
                  const active = this.state.quickStateFilter === st;
                  const label = st === 'all' ? 'All States' : st;
                  return `<button type="button" onclick="app.setQuickStateFilter('${st}')" class="px-2 py-1 rounded text-[11px] font-medium border transition-colors ${active ? 'bg-slate-900 text-white border-slate-900' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50'}">${esc(label)}</button>`;
                }).join('')}
              </div>
            </div>

            <!-- Dense Fleet Table -->
            <div class="bg-white border border-slate-200 rounded-md overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                      <th class="py-2.5 px-3">Agent ID & Trigger</th>
                      <th class="py-2.5 px-3">Mode</th>
                      <th class="py-2.5 px-3">State</th>
                      <th class="py-2.5 px-3">Last Wake & Outcome</th>
                      <th class="py-2.5 px-3">Next Timer</th>
                      <th class="py-2.5 px-3">Queue Depth</th>
                      <th class="py-2.5 px-3 text-right">Consec. Err</th>
                      <th class="py-2.5 px-3">24h Budget</th>
                      <th class="py-2.5 px-3 text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody id="fleet-table-body" class="divide-y divide-slate-200">
                    ${this.buildFleetRowsHTML(agents)}
                  </tbody>
                </table>
              </div>
              <div id="fleet-table-footer" class="px-3 py-2 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-500">
                <span>Showing <strong class="font-mono text-slate-700">${agents.length}</strong> of <strong class="font-mono text-slate-700">${this.state.agents.length}</strong> persistent agents</span>
                <span class="font-mono">Click any row to open State & Journal Inspector</span>
              </div>
            </div>
          </div>
        `;
      },

      buildFleetRowsHTML(agents) {
        if (agents.length === 0) {
          return `<tr><td colspan="9" class="py-8 text-center text-slate-500 text-[12px]">No agents match the active filter criteria.</td></tr>`;
        }
        return agents.map((a) => {
          const pct = Math.min(100, Math.round((a.budgetUsed / a.budgetCap) * 100));
          const barColor = pct >= 80 ? 'bg-amber-500' : 'bg-slate-700';
          const errHighlight = a.consecutiveErrors >= 5
            ? 'bg-red-50 text-red-700 border border-red-200 font-semibold px-1.5 py-0.5 rounded'
            : 'text-slate-500';

          const wakeTagColor = a.lastWakeType === 'Failed'
            ? 'text-red-700 font-medium'
            : a.lastWakeType === 'Triggered'
              ? 'text-blue-700 font-medium'
              : 'text-slate-600 font-medium';

          const timerHTML = typeof a.nextTimerSec === 'number' && a.state !== 'Paused' && a.state !== 'Blocked'
            ? `<span class="font-mono text-[12px] text-slate-700 tabular-nums" data-live-agent-timer="${esc(a.id)}">in ${formatCountdown(a.nextTimerSec)}</span>`
            : `<span class="font-mono text-[11px] text-slate-500">${esc(a.nextTimerLabel || 'Event-driven')}</span>`;

          const queueHTML = (a.queueActive === 0 && a.queuePending === 0)
            ? `<span class="font-mono text-[12px] text-slate-400">0</span>`
            : `<span class="font-mono text-[11px] text-slate-800">${a.queueActive} active / ${a.queuePending} queued</span>`;

          return `
            <tr onclick="app.navigate('detail', '${esc(a.id)}')" class="hover:bg-slate-50/90 cursor-pointer transition-colors group">
              <td class="py-2.5 px-3 align-top">
                <div class="font-mono text-[12px] font-semibold text-slate-900 group-hover:text-blue-700">${esc(a.id)}</div>
                <div class="text-[11px] text-slate-500 mt-0.5">${esc(a.schedule)}</div>
              </td>
              <td class="py-2.5 px-3 align-top whitespace-nowrap">${this.renderModeBadge(a.mode)}</td>
              <td class="py-2.5 px-3 align-top whitespace-nowrap">${this.renderStateBadge(a.state)}</td>
              <td class="py-2.5 px-3 align-top max-w-xs">
                <div class="text-[12px] text-slate-800 truncate" title="${esc(a.lastWakeSummary)}">
                  <span class="${wakeTagColor}">${esc(a.lastWakeType)}</span>
                  <span class="text-slate-400 mx-1">·</span>
                  <span class="font-mono text-[11px] text-slate-500">${esc(a.lastWakeAgo)}</span>
                </div>
                <div class="text-[11px] text-slate-500 truncate mt-0.5">${esc(a.lastWakeSummary)}</div>
              </td>
              <td class="py-2.5 px-3 align-top whitespace-nowrap">${timerHTML}</td>
              <td class="py-2.5 px-3 align-top whitespace-nowrap">${queueHTML}</td>
              <td class="py-2.5 px-3 align-top text-right whitespace-nowrap">
                <span class="font-mono text-[12px] tabular-nums ${errHighlight}">${a.consecutiveErrors}</span>
              </td>
              <td class="py-2.5 px-3 align-top whitespace-nowrap">
                <div class="font-mono text-[11px] text-slate-800 tabular-nums">$${a.budgetUsed.toFixed(2)} <span class="text-slate-400">/ $${a.budgetCap.toFixed(2)}</span></div>
                <div class="w-24 h-1.5 bg-slate-100 rounded-full overflow-hidden mt-1 border border-slate-200/70">
                  <div class="h-full ${barColor}" style="width: ${pct}%"></div>
                </div>
              </td>
              <td class="py-2.5 px-3 align-top text-right whitespace-nowrap" onclick="event.stopPropagation()">
                <div class="inline-flex items-center gap-1">
                  <button type="button" onclick="app.togglePauseAgent('${esc(a.id)}', event)" class="px-2 py-1 rounded border border-slate-200 bg-white hover:bg-slate-50 text-[11px] font-medium text-slate-700">
                    ${a.state === 'Paused' ? 'Resume' : 'Pause'}
                  </button>
                  <button type="button" onclick="app.navigate('detail', '${esc(a.id)}')" class="px-2 py-1 rounded border border-slate-200 bg-slate-50 hover:bg-slate-100 text-[11px] font-medium text-slate-800">
                    Inspect
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      },

      renderFleetTableOnly() {
        const tbody = document.getElementById('fleet-table-body');
        const footer = document.getElementById('fleet-table-footer');
        if (!tbody) return;
        const agents = this.getFilteredAgents();
        tbody.innerHTML = this.buildFleetRowsHTML(agents);
        if (footer) {
          footer.innerHTML = `
            <span>Showing <strong class="font-mono text-slate-700">${agents.length}</strong> of <strong class="font-mono text-slate-700">${this.state.agents.length}</strong> persistent agents</span>
            <span class="font-mono">Click any row to open State & Journal Inspector</span>
          `;
        }
      },

      /**
       * =====================================================================
       * 4. AGENT DETAIL VIEW (4 Tabs)
       * =====================================================================
       */
      buildDetailViewHTML() {
        const a = this.getAgent(this.state.selectedAgentId) || this.state.agents[0];
        if (!a) return '';

        const tabs = [
          { key: 'journal', label: 'Journal & Traces', count: a.journal.length },
          { key: 'ticks', label: 'Ticks & Triggers', count: a.ticks.length },
          { key: 'state', label: 'Durable State & Memory', count: Object.keys(a.durableState).length },
          { key: 'policy', label: 'Guardrails & Policy', count: a.policies.length }
        ];

        let dryRunHTML = '';
        if (this.state.dryRunBanner && this.state.dryRunBanner.agentId === a.id) {
          const dr = this.state.dryRunBanner;
          const isTrig = dr.result === 'Triggered';
          dryRunHTML = `
            <div class="rounded-md border ${isTrig ? 'border-blue-200 bg-blue-50 text-blue-950' : 'border-emerald-200 bg-emerald-50 text-emerald-950'} px-3.5 py-2.5 flex items-start justify-between gap-3">
              <div class="space-y-0.5 text-[12px]">
                <div class="flex items-center gap-2">
                  <span class="font-semibold">Preview Tick (Dry Run):</span>
                  <span class="font-mono text-[11px] px-1.5 py-0.5 rounded border ${isTrig ? 'bg-blue-100 border-blue-300 text-blue-900' : 'bg-emerald-100 border-emerald-300 text-emerald-900'}">${esc(dr.result)}</span>
                  <span class="font-mono text-[11px] opacity-75">${dr.durationMs}ms · ${esc(dr.ts)}</span>
                </div>
                <div class="text-[12px] opacity-90">${esc(dr.reason)}</div>
              </div>
              <button type="button" onclick="app.dismissDryRunBanner()" class="text-[11px] underline opacity-75 hover:opacity-100 shrink-0">Dismiss</button>
            </div>
          `;
        }

        const pendingApproval = this.state.approvals.find(ap => ap.agentId === a.id);
        const approvalNoticeHTML = pendingApproval ? `
          <div class="rounded-md border border-amber-300 bg-amber-50 px-3.5 py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[12px] text-amber-950">
            <div>
              <strong class="font-semibold">Execution Suspended at Policy Gate:</strong>
              Waiting for operator sign-off on <span class="font-mono font-medium">${esc(pendingApproval.tool)}</span> (<span class="font-mono">${esc(pendingApproval.id)}</span>).
            </div>
            <button type="button" onclick="app.selectApproval('${esc(pendingApproval.id)}'); app.navigate('approvals');" class="px-2.5 py-1 rounded bg-amber-900 text-white text-[11px] font-medium hover:bg-amber-800 shrink-0">Open in Approvals Queue</button>
          </div>
        ` : '';

        return `
          <div class="p-4 sm:p-5 max-w-[1440px] mx-auto space-y-4">
            <!-- Breadcrumb -->
            <div class="flex items-center gap-1.5 text-[12px] text-slate-500">
              <button type="button" onclick="app.navigate('fleet')" class="hover:text-slate-900 hover:underline">Fleet Overview</button>
              <span>/</span>
              <span class="font-mono text-slate-800 font-medium">${esc(a.id)}</span>
            </div>

            <!-- Agent Header & Deterministic Operator Controls -->
            <div class="bg-white border border-slate-200 rounded-md p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
              <div class="space-y-1.5">
                <div class="flex items-center gap-2.5 flex-wrap">
                  <h1 class="font-mono text-[16px] font-semibold text-slate-900">${esc(a.id)}</h1>
                  ${this.renderStateBadge(a.state)}
                  ${this.renderModeBadge(a.mode)}
                  ${a.consecutiveErrors >= 5 ? `<span class="px-2 py-0.5 rounded bg-red-50 border border-red-200 text-red-700 font-mono text-[11px] font-semibold">${a.consecutiveErrors} consecutive failures</span>` : ''}
                </div>
                <div class="flex items-center gap-3 text-[12px] text-slate-500 flex-wrap">
                  <span>${esc(a.schedule)}</span>
                  <span class="text-slate-300">|</span>
                  <span class="font-mono text-[11px]">${esc(a.identity)}</span>
                  <span class="text-slate-300">|</span>
                  <span class="font-mono text-[11px]">24h Spend: $${a.budgetUsed.toFixed(2)} / $${a.budgetCap.toFixed(2)}</span>
                </div>
              </div>

              <!-- Operator Controls -->
              <div class="flex items-center gap-2 flex-wrap">
                <button type="button" onclick="app.togglePauseAgent('${esc(a.id)}')" class="px-2.5 py-1.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-[12px] font-medium text-slate-800">
                  ${a.state === 'Paused' ? 'Resume' : 'Pause'}
                </button>
                <button type="button" onclick="app.runPreviewTick('${esc(a.id)}')" class="px-2.5 py-1.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-[12px] font-medium text-slate-800">
                  Preview Tick (Dry Run)
                </button>
                <button type="button" onclick="app.openInjectModal('${esc(a.id)}')" class="px-2.5 py-1.5 rounded border border-slate-900 bg-slate-900 hover:bg-slate-800 text-white text-[12px] font-medium">
                  Inject Event
                </button>
                <button type="button" onclick="app.resetCheckpoint('${esc(a.id)}')" class="px-2.5 py-1.5 rounded border border-slate-300 bg-slate-50 hover:bg-slate-100 text-[12px] font-medium text-slate-700">
                  Reset Checkpoint
                </button>
              </div>
            </div>

            ${approvalNoticeHTML}
            ${dryRunHTML}

            <!-- Tab Bar -->
            <div class="border-b border-slate-200 flex items-center gap-1 overflow-x-auto">
              ${tabs.map(t => {
                const active = this.state.activeDetailTab === t.key;
                return `<button type="button" onclick="app.setDetailTab('${t.key}')" class="px-3.5 py-2 text-[12px] font-medium border-b-2 whitespace-nowrap transition-colors ${active ? 'border-slate-900 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800 hover:border-slate-300'}">
                  ${esc(t.label)} <span class="ml-1 font-mono text-[11px] text-slate-400">${t.count}</span>
                </button>`;
              }).join('')}
            </div>

            <!-- Active Tab Surface -->
            <div>
              ${this.state.activeDetailTab === 'journal' ? this.buildJournalTabHTML(a) : ''}
              ${this.state.activeDetailTab === 'ticks' ? this.buildTicksTabHTML(a) : ''}
              ${this.state.activeDetailTab === 'state' ? this.buildStateTabHTML(a) : ''}
              ${this.state.activeDetailTab === 'policy' ? this.buildPolicyTabHTML(a) : ''}
            </div>
          </div>
        `;
      },

      /**
       * Tab 1: Journal & Traces (Restate / Temporal style)
       */
      buildJournalTabHTML(a) {
        const typeColors = {
          wake_trigger: 'bg-slate-100 text-slate-700 border-slate-200',
          tool_call: 'bg-blue-50 text-blue-700 border-blue-200',
          policy_gate: 'bg-purple-50 text-purple-700 border-purple-200',
          set_state: 'bg-emerald-50 text-emerald-700 border-emerald-200',
          await_approval: 'bg-amber-50 text-amber-800 border-amber-200',
          sleep: 'bg-slate-50 text-slate-600 border-slate-200'
        };

        return `
          <div class="bg-white border border-slate-200 rounded-md overflow-hidden">
            <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between text-[11px] text-slate-500">
              <span class="font-semibold uppercase tracking-wider">Durable Execution Journal (Append-Only)</span>
              <span class="font-mono">Click any step to inspect Structured vs. Raw JSON payload</span>
            </div>
            <div class="divide-y divide-slate-200">
              ${a.journal.map((s) => {
                const key = `${a.id}:${s.step}`;
                const expanded = !!this.state.expandedSteps[key];
                const mode = this.state.stepPayloadMode[key] || 'structured';
                const badgeCls = typeColors[s.type] || 'bg-slate-100 text-slate-700 border-slate-200';
                const statusDot = s.status === 'Failed' ? 'bg-red-500' : s.status === 'Blocked' ? 'bg-amber-500' : s.status === 'Running' ? 'bg-blue-500' : 'bg-emerald-500';

                return `
                  <div>
                    <div onclick="app.toggleStepExpand('${esc(a.id)}', ${s.step})" class="px-4 py-2.5 flex items-center justify-between gap-3 hover:bg-slate-50 cursor-pointer">
                      <div class="flex items-center gap-2.5 min-w-0">
                        <span class="font-mono text-[11px] text-slate-400 w-6 shrink-0">#${String(s.step).padStart(2, '0')}</span>
                        <span class="w-1.5 h-1.5 rounded-full shrink-0 ${statusDot}"></span>
                        <span class="font-mono text-[11px] px-1.5 py-0.5 rounded border shrink-0 ${badgeCls}">${esc(s.type)}</span>
                        <span class="text-[12px] text-slate-800 truncate">${esc(s.summary)}</span>
                      </div>
                      <div class="flex items-center gap-4 shrink-0 font-mono text-[11px] text-slate-500 tabular-nums">
                        <span class="hidden sm:inline">${s.latencyMs}ms</span>
                        <span class="hidden md:inline">${s.tokens} tok</span>
                        <span class="hidden lg:inline">${esc(s.timestamp)}</span>
                        <svg class="w-3.5 h-3.5 text-slate-400 transition-transform ${expanded ? 'rotate-180' : ''}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
                      </div>
                    </div>

                    ${expanded ? `
                      <div class="px-4 pb-3 pt-1 bg-slate-50/70 border-t border-slate-100">
                        <div class="flex items-center justify-between mb-2">
                          <div class="inline-flex rounded border border-slate-200 bg-white p-0.5 text-[11px]">
                            <button type="button" onclick="app.setStepPayloadMode('${esc(a.id)}', ${s.step}, 'structured')" class="px-2 py-0.5 rounded font-medium ${mode === 'structured' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:text-slate-900'}">Structured</button>
                            <button type="button" onclick="app.setStepPayloadMode('${esc(a.id)}', ${s.step}, 'raw')" class="px-2 py-0.5 rounded font-medium ${mode === 'raw' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:text-slate-900'}">Raw JSON</button>
                          </div>
                          ${s.status === 'Completed' ? `
                            <button type="button" onclick="app.resetCheckpoint('${esc(a.id)}', ${s.step})" class="px-2 py-1 rounded border border-slate-300 bg-white hover:bg-slate-100 text-[11px] font-medium text-slate-700">
                              Reset to here (#${String(s.step).padStart(2, '0')})
                            </button>
                          ` : ''}
                        </div>

                        ${mode === 'structured' ? `
                          <div class="bg-white border border-slate-200 rounded p-2.5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                            ${Object.entries(s.structured).map(([k, v]) => `
                              <div class="text-[11px]">
                                <div class="font-mono text-slate-400">${esc(k)}</div>
                                <div class="font-mono text-slate-900 break-all">${esc(typeof v === 'object' ? JSON.stringify(v) : v)}</div>
                              </div>
                            `).join('')}
                          </div>
                        ` : `
                          <pre class="bg-white border border-slate-200 rounded p-2.5 font-mono text-[11px] text-slate-800 overflow-x-auto leading-relaxed">${esc(JSON.stringify(s.raw, null, 2))}</pre>
                        `}
                      </div>
                    ` : ''}
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      },

      /**
       * Tab 2: Ticks & Triggers (Dagster Sensors style)
       */
      buildTicksTabHTML(a) {
        const filteredTicks = this.state.hideSkippedTicks
          ? a.ticks.filter(t => t.result !== 'Skipped')
          : a.ticks;

        return `
          <div class="bg-white border border-slate-200 rounded-md overflow-hidden">
            <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-2">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Daemon Heartbeat & Sensor Tick History</span>
              <label class="inline-flex items-center gap-2 text-[12px] text-slate-700 cursor-pointer select-none">
                <input type="checkbox" ${this.state.hideSkippedTicks ? 'checked' : ''} onchange="app.toggleHideSkipped()" class="rounded border-slate-300 text-slate-900 focus:ring-0" />
                <span>Hide Skipped</span>
              </label>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-slate-200 text-[11px] font-semibold uppercase tracking-wider text-slate-500 bg-white">
                    <th class="py-2 px-4">Timestamp (UTC)</th>
                    <th class="py-2 px-4">Result</th>
                    <th class="py-2 px-4">Duration</th>
                    <th class="py-2 px-4">SkipReason / Trigger Summary</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-[12px]">
                  ${filteredTicks.length === 0 ? `
                    <tr><td colspan="4" class="py-6 text-center text-slate-500">All recorded ticks were Skipped. Uncheck "Hide Skipped" to view heartbeat evaluations.</td></tr>
                  ` : filteredTicks.map(t => {
                    const pill = t.result === 'Triggered'
                      ? 'bg-blue-50 text-blue-700 border-blue-200'
                      : t.result === 'Failed'
                        ? 'bg-red-50 text-red-700 border-red-200'
                        : 'bg-slate-100 text-slate-600 border-slate-200';
                    return `
                      <tr class="hover:bg-slate-50">
                        <td class="py-2 px-4 font-mono text-[11px] text-slate-600 whitespace-nowrap">${esc(t.ts)}</td>
                        <td class="py-2 px-4 whitespace-nowrap"><span class="px-1.5 py-0.5 rounded border text-[11px] font-medium ${pill}">${esc(t.result)}</span></td>
                        <td class="py-2 px-4 font-mono text-[11px] text-slate-600 whitespace-nowrap tabular-nums">${t.durationMs}ms</td>
                        <td class="py-2 px-4 text-slate-800">${esc(t.reason)}</td>
                      </tr>
                    `;
                  }).join('')}
                </tbody>
              </table>
            </div>
          </div>
        `;
      },

      /**
       * Tab 3: Durable State & Memory (Restate / Letta style)
       */
      buildStateTabHTML(a) {
        const cb = a.contextBudget;
        const used = cb.system + cb.state + cb.journal;
        const avail = Math.max(0, cb.total - used);
        const pctSys = ((cb.system / cb.total) * 100).toFixed(1);
        const pctState = ((cb.state / cb.total) * 100).toFixed(1);
        const pctJournal = ((cb.journal / cb.total) * 100).toFixed(1);

        return `
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
            <!-- Editable Live K/V State Panel -->
            <div class="lg:col-span-7 bg-white border border-slate-200 rounded-md overflow-hidden flex flex-col">
              <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <div>
                  <div class="text-[12px] font-semibold text-slate-900">Durable K/V State (Live Virtual Object)</div>
                  <div class="text-[11px] text-slate-500">Directly inspect or patch persistent state. Saving logs an audited state patch in the journal.</div>
                </div>
                <button type="button" onclick="app.saveDurableState('${esc(a.id)}')" class="px-2.5 py-1.5 rounded bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-medium shrink-0">
                  Save & Patch State
                </button>
              </div>
              <div class="p-3 flex-1 flex flex-col">
                <textarea id="durable-state-editor" rows="13" class="w-full flex-1 rounded border border-slate-200 bg-slate-50 focus:bg-white focus:border-slate-400 focus:outline-none p-3 font-mono text-[12px] text-slate-900 leading-relaxed">${esc(JSON.stringify(a.durableState, null, 2))}</textarea>
                <p id="state-editor-error" class="hidden mt-1.5 text-[11px] font-mono text-red-600"></p>
              </div>
            </div>

            <!-- Right Column: Invocation Queue + Context Window Budget -->
            <div class="lg:col-span-5 space-y-4">
              <!-- Context Window Budget Bar -->
              <div class="bg-white border border-slate-200 rounded-md p-4 space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-[12px] font-semibold text-slate-900">Context Window Budget</span>
                  <span class="font-mono text-[11px] text-slate-500 tabular-nums">${used.toLocaleString()} / ${cb.total.toLocaleString()} tokens</span>
                </div>
                <div class="w-full h-2.5 bg-slate-100 rounded overflow-hidden flex border border-slate-200">
                  <div class="bg-slate-800 h-full" style="width: ${pctSys}%" title="System Prompt"></div>
                  <div class="bg-blue-600 h-full" style="width: ${pctState}%" title="Durable State"></div>
                  <div class="bg-amber-500 h-full" style="width: ${pctJournal}%" title="Recent Journal"></div>
                </div>
                <div class="grid grid-cols-2 gap-2 text-[11px]">
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1.5 text-slate-600"><span class="w-2 h-2 rounded-sm bg-slate-800"></span>System Prompt</span><span class="font-mono text-slate-800">${cb.system.toLocaleString()}</span></div>
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1.5 text-slate-600"><span class="w-2 h-2 rounded-sm bg-blue-600"></span>Durable State</span><span class="font-mono text-slate-800">${cb.state.toLocaleString()}</span></div>
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1.5 text-slate-600"><span class="w-2 h-2 rounded-sm bg-amber-500"></span>Recent Journal</span><span class="font-mono text-slate-800">${cb.journal.toLocaleString()}</span></div>
                  <div class="flex items-center justify-between"><span class="flex items-center gap-1.5 text-slate-600"><span class="w-2 h-2 rounded-sm bg-slate-200"></span>Available</span><span class="font-mono text-slate-800">${avail.toLocaleString()}</span></div>
                </div>
              </div>

              <!-- Invocation Queue Panel -->
              <div class="bg-white border border-slate-200 rounded-md overflow-hidden">
                <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                  <span class="text-[12px] font-semibold text-slate-900">Invocation Queue</span>
                  <span class="font-mono text-[11px] text-slate-500">${a.invocationQueue.length} item(s)</span>
                </div>
                <div class="divide-y divide-slate-200">
                  ${a.invocationQueue.length === 0 ? `
                    <div class="p-4 text-center text-[12px] text-slate-500">No active or queued invocations.</div>
                  ` : a.invocationQueue.map(inv => {
                    const isQueued = inv.status.startsWith('Queued');
                    return `
                      <div class="p-3 flex items-start justify-between gap-2">
                        <div class="min-w-0">
                          <div class="flex items-center gap-2">
                            <span class="font-mono text-[11px] font-semibold text-slate-900">${esc(inv.id)}</span>
                            <span class="px-1.5 py-0.5 rounded text-[10px] font-medium border ${isQueued ? 'bg-slate-50 text-slate-600 border-slate-200' : 'bg-blue-50 text-blue-700 border-blue-200'}">${esc(inv.status)}</span>
                          </div>
                          <div class="font-mono text-[11px] text-slate-700 mt-0.5">${esc(inv.type)}</div>
                          <div class="font-mono text-[11px] text-slate-400 truncate mt-0.5">${esc(inv.payload)}</div>
                        </div>
                        <div class="text-right shrink-0 space-y-1">
                          <div class="font-mono text-[10px] text-slate-400">${esc(inv.enqueuedAt)}</div>
                          ${isQueued ? `<button type="button" onclick="app.cancelQueuedInvocation('${esc(a.id)}', '${esc(inv.id)}')" class="px-2 py-0.5 rounded border border-red-200 bg-red-50 hover:bg-red-100 text-[11px] font-medium text-red-700">Cancel</button>` : ''}
                        </div>
                      </div>
                    `;
                  }).join('')}
                </div>
              </div>
            </div>
          </div>
        `;
      },

      /**
       * Tab 4: Guardrails & Policy (Azure SRE Agent style)
       */
      buildPolicyTabHTML(a) {
        const rules = ['Allow', 'Ask', 'Deny'];

        return `
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
            <!-- Per-Tool Policy Matrix -->
            <div class="lg:col-span-8 bg-white border border-slate-200 rounded-md overflow-hidden">
              <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <div>
                  <div class="text-[12px] font-semibold text-slate-900">Per-Tool Execution Policy Matrix</div>
                  <div class="text-[11px] text-slate-500">Enforced deterministically by the runtime before tool dispatch.</div>
                </div>
                ${this.state.safeMode ? `<span class="px-2 py-0.5 rounded bg-amber-100 border border-amber-300 text-amber-900 font-mono text-[11px]">Safe Mode Overrides Allow -> Ask on Writes</span>` : ''}
              </div>
              <div class="divide-y divide-slate-200">
                ${a.policies.map(p => {
                  return `
                    <div class="px-4 py-2.5 flex items-center justify-between gap-3">
                      <div class="flex items-center gap-2.5 min-w-0">
                        <span class="font-mono text-[12px] font-medium text-slate-900">${esc(p.tool)}</span>
                        <span class="px-1.5 py-0.5 rounded text-[10px] font-mono uppercase ${p.scope === 'write' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'bg-slate-100 text-slate-600 border border-slate-200'}">${esc(p.scope)}</span>
                      </div>
                      <div class="inline-flex rounded border border-slate-200 bg-slate-50 p-0.5 text-[11px] shrink-0">
                        ${rules.map(r => {
                          const active = p.rule === r;
                          const activeCls = r === 'Allow'
                            ? 'bg-emerald-600 text-white'
                            : r === 'Ask'
                              ? 'bg-amber-500 text-white'
                              : 'bg-red-600 text-white';
                          return `<button type="button" onclick="app.setToolPolicy('${esc(a.id)}', '${esc(p.tool)}', '${r}')" class="px-2.5 py-0.5 rounded font-medium transition-colors ${active ? activeCls : 'text-slate-600 hover:text-slate-900'}">${r}</button>`;
                        }).join('')}
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>

            <!-- Hard Deterministic Limits Panel -->
            <div class="lg:col-span-4 bg-white border border-slate-200 rounded-md overflow-hidden h-fit">
              <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200">
                <div class="text-[12px] font-semibold text-slate-900">Hard Deterministic Guardrails</div>
              </div>
              <div class="p-4 space-y-3 text-[12px]">
                <div class="flex justify-between items-center py-1 border-b border-slate-100">
                  <span class="text-slate-500">Max Steps per Wake</span>
                  <span class="font-mono font-semibold text-slate-900">${a.limits.maxSteps} steps</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-slate-100">
                  <span class="text-slate-500">Daily Budget Cap</span>
                  <span class="font-mono font-semibold text-slate-900">$${a.limits.dailyBudget.toFixed(2)} / 24h</span>
                </div>
                <div class="flex justify-between items-center py-1 border-b border-slate-100">
                  <span class="text-slate-500">Loop Detection Threshold</span>
                  <span class="font-mono font-semibold text-slate-900">${a.limits.loopThreshold} identical calls</span>
                </div>
                <div class="pt-1 space-y-1">
                  <div class="text-slate-500 text-[11px]">Principal / Identity Attribution</div>
                  <div class="font-mono text-[11px] bg-slate-50 border border-slate-200 rounded px-2.5 py-1.5 text-slate-800 break-all">${esc(a.identity)}</div>
                </div>
              </div>
            </div>
          </div>
        `;
      },

      /**
       * =====================================================================
       * 5. APPROVALS QUEUE (Master-Detail Triage View)
       * =====================================================================
       */
      buildApprovalsViewHTML() {
        const list = this.state.approvals;
        if (list.length === 0) {
          return `
            <div class="p-6 max-w-2xl mx-auto mt-10">
              <div class="bg-white border border-slate-200 rounded-md p-8 text-center space-y-3">
                <div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 mx-auto flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                <h2 class="text-[15px] font-semibold text-slate-900">Approvals Queue Clear</h2>
                <p class="text-[12px] text-slate-500">No persistent agents are currently blocked on human policy gates.</p>
                <div class="pt-2">
                  <button type="button" onclick="app.navigate('fleet')" class="px-3 py-1.5 rounded bg-slate-900 text-white text-[12px] font-medium hover:bg-slate-800">Return to Fleet Overview</button>
                </div>
              </div>
            </div>
          `;
        }

        const active = list.find(x => x.id === this.state.selectedApprovalId) || list[0];
        const isModifying = this.state.modifyingApprovalId === active.id;

        return `
          <div class="p-4 sm:p-5 max-w-[1440px] mx-auto space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h1 class="text-[16px] font-semibold text-slate-900 tracking-tight">Approvals Queue</h1>
                <p class="text-[12px] text-slate-500">Triage suspended agents awaiting human sign-off for gated tool executions.</p>
              </div>
              <span class="font-mono text-[11px] px-2 py-1 rounded bg-amber-50 border border-amber-200 text-amber-900">${list.length} pending</span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
              <!-- Left Master List -->
              <div class="lg:col-span-4 bg-white border border-slate-200 rounded-md divide-y divide-slate-200 overflow-hidden">
                ${list.map(ap => {
                  const selected = ap.id === active.id;
                  return `
                    <button type="button" onclick="app.selectApproval('${esc(ap.id)}')" class="w-full text-left p-3.5 transition-colors ${selected ? 'bg-slate-50 border-l-2 border-l-slate-900' : 'bg-white hover:bg-slate-50/70'}">
                      <div class="flex items-center justify-between gap-2">
                        <span class="font-mono text-[12px] font-semibold text-slate-900 truncate">${esc(ap.agentId)}</span>
                        <span class="px-1.5 py-0.5 rounded bg-amber-50 border border-amber-200 text-amber-800 font-mono text-[10px] shrink-0">${esc(ap.policyRule)}</span>
                      </div>
                      <div class="font-mono text-[11px] text-blue-700 mt-1">${esc(ap.tool)}</div>
                      <div class="text-[11px] text-slate-500 truncate mt-0.5">${esc(ap.target)}</div>
                      <div class="mt-2 flex items-center justify-between text-[11px] font-mono">
                        <span class="text-slate-400">${esc(ap.id)}</span>
                        <span class="text-amber-700 font-medium tabular-nums" data-live-approval-timer="${esc(ap.id)}">Expires in ${formatCountdown(ap.expiresInSec)}</span>
                      </div>
                    </button>
                  `;
                }).join('')}
              </div>

              <!-- Right Detail Pane -->
              <div class="lg:col-span-8 bg-white border border-slate-200 rounded-md overflow-hidden">
                <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-[13px] font-semibold text-slate-900">${esc(active.tool)}</span>
                      <span class="px-1.5 py-0.5 rounded bg-amber-50 border border-amber-200 text-amber-800 font-mono text-[10px]">${esc(active.policyRule)} · ${esc(active.policyId)}</span>
                    </div>
                    <div class="text-[11px] text-slate-500 mt-0.5">
                      Requested by <button type="button" onclick="app.navigate('detail', '${esc(active.agentId)}')" class="font-mono text-slate-800 underline hover:text-blue-700">${esc(active.agentId)}</button> at <span class="font-mono">${esc(active.requestedAt)}</span>
                    </div>
                  </div>
                  <div class="font-mono text-[11px] text-amber-800 bg-amber-50 border border-amber-200 px-2 py-1 rounded tabular-nums shrink-0" data-live-approval-timer="${esc(active.id)}">
                    Expires in ${formatCountdown(active.expiresInSec)}
                  </div>
                </div>

                <div class="p-4 space-y-4">
                  <!-- Why the agent requested this -->
                  <div class="space-y-2">
                    <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Why the Agent Requested This</div>
                    <p class="text-[12px] text-slate-800 leading-relaxed bg-slate-50 border border-slate-200 rounded p-3">${esc(active.why)}</p>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                      ${active.evidence.map(ev => `
                        <div class="border border-slate-200 rounded px-2.5 py-2 bg-white">
                          <div class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">${esc(ev.label)}</div>
                          <div class="font-mono text-[11px] text-slate-900 mt-0.5">${esc(ev.value)}</div>
                        </div>
                      `).join('')}
                    </div>
                  </div>

                  <!-- Exact Proposed Tool Call & Payload -->
                  <div class="space-y-2">
                    <div class="flex items-center justify-between">
                      <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Exact Proposed Tool Call & Payload</span>
                      <button type="button" onclick="app.toggleModifyApprovalPayload('${esc(active.id)}')" class="text-[11px] font-medium text-slate-700 hover:text-slate-950 underline">
                        ${isModifying ? 'Cancel Edit' : 'Modify Payload'}
                      </button>
                    </div>
                    ${isModifying ? `
                      <div>
                        <textarea id="approval-payload-editor" rows="10" class="w-full rounded border border-slate-300 bg-white p-3 font-mono text-[12px] text-slate-900 focus:outline-none focus:border-slate-500">${esc(JSON.stringify(active.payload, null, 2))}</textarea>
                        <p id="approval-payload-error" class="hidden mt-1 text-[11px] font-mono text-red-600"></p>
                      </div>
                    ` : `
                      <pre class="bg-slate-50 border border-slate-200 rounded p-3 font-mono text-[12px] text-slate-900 overflow-x-auto leading-relaxed">${esc(JSON.stringify(active.payload, null, 2))}</pre>
                    `}
                  </div>
                </div>

                <!-- Action Footer -->
                <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <span class="text-[11px] text-slate-500 font-mono">Resume Token: rtk_${esc(active.id)}</span>
                  <div class="flex items-center gap-2">
                    <button type="button" onclick="app.resolveApproval('${esc(active.id)}', 'reject')" class="px-3 py-1.5 rounded border border-slate-300 bg-white hover:bg-red-50 hover:border-red-300 hover:text-red-800 text-[12px] font-medium text-slate-700 transition-colors">
                      Reject & Return to Sleep
                    </button>
                    <button type="button" onclick="app.resolveApproval('${esc(active.id)}', 'approve')" class="px-3 py-1.5 rounded bg-emerald-700 hover:bg-emerald-800 text-white text-[12px] font-medium transition-colors">
                      Approve & Resume
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      }
    };

    // Boot the console on load
    window.addEventListener('DOMContentLoaded', () => app.init());
  </script>
</body>
</html>
