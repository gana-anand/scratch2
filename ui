      /**
       * Non-destructive 1-second timer loop (updates only targeted data-live-* spans
       * so inputs/textareas never lose focus).
       */
      startLiveTimers() {
        setInterval(() => {
          this.state.daemonTickSec = (this.state.daemonTickSec + 1) % 6;
          if (this.state.daemonTickSec === 0) this.state.daemonTickSec = 1;

          document.querySelectorAll('[data-live-daemon]').forEach((el) => {
            el.textContent = `(tick ${this.state.daemonTickSec}s ago)`;
          });

          this.state.agents.forEach((a) => {
            if (typeof a.nextTimerSec === 'number' && a.state !== 'Paused' && a.state !== 'Blocked') {
              a.nextTimerSec = a.nextTimerSec > 1 ? a.nextTimerSec - 1 : 180;
              document.querySelectorAll(`[data-live-agent-timer="${a.id}"]`).forEach((el) => {
                el.textContent = `in ${formatCountdown(a.nextTimerSec)}`;
              });
            }
          });

          this.state.approvals.forEach((ap) => {
            if (ap.expiresInSec > 0) {
              ap.expiresInSec -= 1;
              document.querySelectorAll(`[data-live-approval-timer="${ap.id}"]`).forEach((el) => {
                el.textContent = `Expires in ${formatCountdown(ap.expiresInSec)}`;
              });
            }
          });
        }, 1000);
      },

      toast(message, tone = 'neutral') {
        const container = document.getElementById('toast-container');
        const el = document.createElement('div');
        const toneClasses = {
          neutral: 'bg-slate-900 text-white border-slate-800',
          success: 'bg-emerald-900 text-emerald-50 border-emerald-800',
          warning: 'bg-amber-900 text-amber-50 border-amber-800',
          danger: 'bg-red-900 text-red-50 border-red-800',
        }[tone] || 'bg-slate-900 text-white border-slate-800';

        el.className = `pointer-events-auto px-3 py-2 rounded border shadow-lg text-[12px] font-medium flex items-center gap-2 transition-opacity duration-200 ${toneClasses}`;
        el.innerHTML = `<span>${esc(message)}</span>`;
        container.appendChild(el);
        setTimeout(() => {
          el.style.opacity = '0';
          setTimeout(() => el.remove(), 220);
        }, 3200);
      },

