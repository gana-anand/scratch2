      renderStateBadge(state) {
        const map = {
          Sleeping: { bg: 'bg-emerald-50 text-emerald-700 border-emerald-200', dot: 'bg-emerald-500' },
          Running:  { bg: 'bg-blue-50 text-blue-700 border-blue-200', dot: 'bg-blue-500' },
          Blocked:  { bg: 'bg-amber-50 text-amber-800 border-amber-200', dot: 'bg-amber-500' },
          Flagged:  { bg: 'bg-red-50 text-red-700 border-red-200', dot: 'bg-red-500' },
          Paused:   { bg: 'bg-slate-100 text-slate-600 border-slate-200', dot: 'bg-slate-400' }
        };
        const cfg = map[state] || map.Paused;
        return `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-[11px] font-medium ${cfg.bg}">
          <span class="w-1.5 h-1.5 rounded-full ${cfg.dot}"></span>${esc(state)}
        </span>`;
      },

      renderModeBadge(mode) {
        if (this.state.safeMode) {
          return `<span class="inline-flex items-center px-1.5 py-0.5 rounded border border-amber-300 bg-amber-50 text-amber-800 font-mono text-[11px] font-medium">Review (Override)</span>`;
        }
        if (mode === 'Autonomous') {
          return `<span class="inline-flex items-center px-1.5 py-0.5 rounded border border-slate-200 bg-slate-50 text-slate-700 font-mono text-[11px]">Autonomous</span>`;
        }
        return `<span class="inline-flex items-center px-1.5 py-0.5 rounded border border-slate-200 bg-white text-slate-600 font-mono text-[11px]">Review</span>`;
      },

