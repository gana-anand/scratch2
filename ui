          smBtn.innerHTML = `
            <span class="w-7 h-4 rounded-full bg-slate-300 relative inline-flex items-center px-0.5"><span class="w-3 h-3 rounded-full bg-white transition-transform"></span></span>
            <span class="hidden sm:inline">Autonomous Allowed</span>
            <span class="sm:hidden">Auto On</span>
          `;
          smBanner.classList.add('hidden');
        }
      },

