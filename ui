            raw: { op: 'OPERATOR_PAUSE', timestamp: nowUtcShort() }
          });
          this.toast(`Paused ${a.id} — durable state preserved`, 'neutral');
        }
        this.renderAll();
      },

      runPreviewTick(agentId) {
        const a = this.getAgent(agentId);
        if (!a) return;

        const willTrigger = a.state === 'Flagged' || a.state === 'Blocked' || a.state === 'Running';
        const durationMs = 45 + Math.floor(Math.random() * 90);
        const result = willTrigger ? 'Triggered' : 'Skipped';
        const reason = willTrigger
          ? `Dry-run condition matched: active drift/error signal detected on ${a.id} (no side effects executed).`
          : `Dry-run evaluated cleanly: all monitored telemetry within configured baseline thresholds.`;

        this.state.dryRunBanner = { agentId, result, reason, durationMs, ts: nowUtcShort() };
        this.renderWorkspace();
        this.toast(`Preview tick completed for ${a.id}: ${result}`, 'neutral');
      },

      dismissDryRunBanner() {
        this.state.dryRunBanner = null;
        this.renderWorkspace();
      },

      resetCheckpoint(agentId, targetStep = null) {
        const a = this.getAgent(agentId);
        if (!a) return;
        const stepNum = targetStep || Math.max(1, a.journal.length - 1);
        a.journal = a.journal.slice(0, stepNum);
        a.journal.push({
          step: a.journal.length + 1,
          type: 'set_state',
          status: 'Completed',
          summary: `Checkpoint rewound to step #${String(stepNum).padStart(2, '0')} by operator`,
          latencyMs: 14,
          tokens: 0,
          timestamp: nowUtcShort(),
          structured: { action: 'RESET_CHECKPOINT', rewoundToStep: stepNum, clearedErrors: a.consecutiveErrors },
          raw: { op: 'RESET_CHECKPOINT', target_step: stepNum, operator: 'console-user' }
        });
        a.consecutiveErrors = 0;
        if (a.state === 'Flagged') {
          a.state = 'Sleeping';
          a.lastWakeType = 'Skipped';
          a.lastWakeAgo = 'just now';
          a.lastWakeSummary = `Reset to checkpoint #${String(stepNum).padStart(2, '0')}`;
        }
        this.renderAll();
        this.toast(`Rewound ${a.id} to checkpoint #${String(stepNum).padStart(2, '0')}`, 'success');
      },

      /**
       * Inject Event Modal
       */
      openInjectModal(preselectAgentId = null) {
        const select = document.getElementById('inject-agent-select');
        select.innerHTML = this.state.agents.map(a =>
          `<option value="${esc(a.id)}" ${a.id === preselectAgentId ? 'selected' : ''}>${esc(a.id)} (${esc(a.state)})</option>`
        ).join('');

        document.getElementById('inject-event-type').value = 'manual.operator_signal';
        document.getElementById('inject-payload').value = JSON.stringify({
          source: 'operator-console',
          force_eval: true,
          correlation_id: 'corr-' + Math.floor(1000 + Math.random() * 9000),
          note: 'Manual verification wake'
        }, null, 2);
        document.getElementById('inject-error').classList.add('hidden');
        document.getElementById('inject-modal').classList.remove('hidden');
      },

      closeInjectModal() {
        document.getElementById('inject-modal').classList.add('hidden');
      },

      submitInjectEvent() {
        const agentId = document.getElementById('inject-agent-select').value;
        const eventType = document.getElementById('inject-event-type').value.trim() || 'manual.operator_signal';
        const rawText = document.getElementById('inject-payload').value;
        const errEl = document.getElementById('inject-error');

        let parsed;
        try {
          parsed = JSON.parse(rawText);
        } catch (err) {
          errEl.textContent = `Invalid JSON: ${err.message}`;
          errEl.classList.remove('hidden');
          return;
        }

        const a = this.getAgent(agentId);
        if (!a) return;

        const ts = nowUtcShort();
        a.ticks.unshift({
          ts: ts.slice(11),
          result: 'Triggered',
          durationMs: 74,
          reason: `Injected signal "${eventType}" (${Object.keys(parsed).length} payload keys)`
        });

        const nextStep = a.journal.length + 1;
        a.journal.push({
          step: nextStep,
          type: 'wake_trigger',
          status: 'Completed',
          summary: `Injected synthetic event "${eventType}"`,
          latencyMs: 19,
          tokens: 140,
          timestamp: ts.slice(11),
          structured: { trigger: eventType, injectedBy: 'operator', ...parsed },
          raw: { event_type: eventType, payload: parsed, injected_at: ts }
        });

        a.lastWakeType = 'Triggered';
        a.lastWakeAgo = 'just now';
        a.lastWakeSummary = `Injected ${eventType}`;
        if (a.state === 'Sleeping') {
          a.state = 'Running';
          a.nextTimerLabel = 'Running now';
        }
        this.state.expandedSteps[`${a.id}:${nextStep}`] = true;

        this.closeInjectModal();
        this.renderAll();
        this.toast(`Dispatched "${eventType}" to ${a.id}`, 'success');
      },

      /**
       * Agent Detail Tab Interactions
       */
      setDetailTab(tab) {
        this.state.activeDetailTab = tab;
        this.renderWorkspace();
      },

      toggleStepExpand(agentId, stepNum) {
        const key = `${agentId}:${stepNum}`;
        this.state.expandedSteps[key] = !this.state.expandedSteps[key];
        this.renderWorkspace();
      },

      setStepPayloadMode(agentId, stepNum, mode) {
        this.state.stepPayloadMode[`${agentId}:${stepNum}`] = mode;
        this.renderWorkspace();
      },

      toggleHideSkipped() {
        this.state.hideSkippedTicks = !this.state.hideSkippedTicks;
        this.renderWorkspace();
      },

      saveDurableState(agentId) {
        const a = this.getAgent(agentId);
        if (!a) return;
        const textarea = document.getElementById('durable-state-editor');
        const errEl = document.getElementById('state-editor-error');
        try {
          const parsed = JSON.parse(textarea.value);
          a.durableState = parsed;
          a.journal.push({
            step: a.journal.length + 1,
            type: 'set_state',
            status: 'Completed',
            summary: 'Operator patched durable K/V state via Console State Inspector',
            latencyMs: 9,
            tokens: 0,
            timestamp: nowUtcShort().slice(11),
            structured: { source: 'operator_patch', keysCount: Object.keys(parsed).length },
            raw: { op: 'PATCH_DURABLE_STATE', state: parsed }
          });
          errEl.classList.add('hidden');
          this.renderWorkspace();
          this.toast(`Patched durable state for ${a.id} & appended journal entry`, 'success');
        } catch (err) {
          errEl.textContent = `JSON Parse Error: ${err.message}`;
          errEl.classList.remove('hidden');
        }
      },

      cancelQueuedInvocation(agentId, invId) {
        const a = this.getAgent(agentId);
        if (!a) return;
        a.invocationQueue = a.invocationQueue.filter(i => i.id !== invId);
        a.queuePending = Math.max(0, a.queuePending - 1);
        this.renderAll();
        this.toast(`Cancelled queued invocation ${invId}`, 'neutral');
      },

      setToolPolicy(agentId, toolName, newRule) {
        const a = this.getAgent(agentId);
        if (!a) return;
        const p = a.policies.find(x => x.tool === toolName);
        if (!p) return;
        p.rule = newRule;
        this.renderWorkspace();
        this.toast(`Policy updated: ${toolName} -> ${newRule}`, 'neutral');
      },

      /**
       * Approvals Queue Actions
       */
      selectApproval(approvalId) {
        this.state.selectedApprovalId = approvalId;
        this.state.modifyingApprovalId = null;
        this.renderWorkspace();
      },

      toggleModifyApprovalPayload(approvalId) {
        this.state.modifyingApprovalId = this.state.modifyingApprovalId === approvalId ? null : approvalId;
        this.renderWorkspace();
      },

      resolveApproval(approvalId, decision) {
        const apIndex = this.state.approvals.findIndex(x => x.id === approvalId);
        if (apIndex === -1) return;
        const ap = this.state.approvals[apIndex];

        // If user was modifying payload, validate & capture it
        let finalPayload = ap.payload;
        if (this.state.modifyingApprovalId === approvalId) {
          const editor = document.getElementById('approval-payload-editor');
          const errEl = document.getElementById('approval-payload-error');
          if (editor) {
            try {
              finalPayload = JSON.parse(editor.value);
            } catch (err) {
              if (errEl) {
                errEl.textContent = `Invalid JSON payload: ${err.message}`;
                errEl.classList.remove('hidden');
              }
              return;
            }
          }
        }

        const agent = this.getAgent(ap.agentId);
        const ts = nowUtcShort().slice(11);

        if (agent) {
          // Mark pending await_approval step completed
          const blockedStep = agent.journal.find(s => s.status === 'Blocked');
          if (blockedStep) blockedStep.status = 'Completed';

          if (decision === 'approve') {
            agent.state = 'Sleeping';
            agent.nextTimerSec = 60;
            agent.nextTimerLabel = null;
            agent.queueActive = 0;
            agent.lastWakeType = 'Triggered';
            agent.lastWakeAgo = 'just now';
            agent.lastWakeSummary = `Approved & executed ${ap.tool}`;
            agent.journal.push({
              step: agent.journal.length + 1,
              type: 'tool_call',
              status: 'Completed',
              summary: `Approved (${ap.id}): executed ${ap.tool} successfully`,
              latencyMs: 284,
              tokens: 210,
              timestamp: ts,
              structured: { approvalId: ap.id, decision: 'APPROVED', tool: ap.tool, result: 'OK' },
              raw: { approval_id: ap.id, decision: 'APPROVED', executed_payload: finalPayload, result: { ok: true } }
            });
            agent.ticks.unshift({
              ts,
              result: 'Triggered',
              durationMs: 284,
              reason: `Operator approved ${ap.id} — executed ${ap.tool}`
            });
          } else {
            agent.state = 'Sleeping';
            agent.nextTimerSec = 60;
            agent.nextTimerLabel = null;
            agent.queueActive = 0;
            agent.lastWakeType = 'Skipped';
            agent.lastWakeAgo = 'just now';
            agent.lastWakeSummary = `Rejected ${ap.tool}; returned to sleep`;
            agent.journal.push({
              step: agent.journal.length + 1,
              type: 'sleep',
              status: 'Completed',
              summary: `Rejected (${ap.id}): ${ap.tool} aborted; agent returned to sleep`,
              latencyMs: 12,
              tokens: 0,
              timestamp: ts,
              structured: { approvalId: ap.id, decision: 'REJECTED', nextState: 'Sleeping' },
              raw: { approval_id: ap.id, decision: 'REJECTED', tool_aborted: ap.tool }
            });
            agent.ticks.unshift({
              ts,
              result: 'Skipped',
              durationMs: 12,
              reason: `Operator rejected ${ap.id} (${ap.tool}); returned to sleep`
            });
          }
        }

        // Remove from queue
        this.state.approvals.splice(apIndex, 1);
        this.state.modifyingApprovalId = null;
        this.state.selectedApprovalId = this.state.approvals[0]?.id || null;

        this.renderAll();
        this.toast(
          decision === 'approve'
            ? `Approved ${ap.id} — ${ap.agentId} resumed and executed ${ap.tool}`
            : `Rejected ${ap.id} — ${ap.agentId} returned to sleep`,
          decision === 'approve' ? 'success' : 'warning'
        );
      },

      /**
       * Helper: Filtered Agents List
       */
      getFilteredAgents() {
        return this.state.agents.filter((a) => {
          // Saved sidebar filter
          if (this.state.savedFilter === 'flagged' && !(a.state === 'Flagged' || a.consecutiveErrors >= 5)) return false;
          if (this.state.savedFilter === 'blocked' && a.state !== 'Blocked') return false;
          if (this.state.savedFilter === 'autonomous' && a.mode !== 'Autonomous') return false;

          // Quick state filter pill
          if (this.state.quickStateFilter !== 'all' && a.state !== this.state.quickStateFilter) return false;

          // Search query
          if (this.state.searchQuery.trim() !== '') {
            const q = this.state.searchQuery.toLowerCase();
            const haystack = `${a.id} ${a.schedule} ${a.lastWakeSummary} ${a.state} ${a.mode}`.toLowerCase();
            if (!haystack.includes(q)) return false;
          }
          return true;
        });
      },

      /**
       * Semantic Badges
