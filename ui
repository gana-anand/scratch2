          `;
        } else {
          apBtn.className = 'inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 text-[12px] font-medium transition-colors';
          apBtn.innerHTML = `
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>Pending Approvals</span>
            <span class="font-mono text-[11px] bg-slate-100 text-slate-600 px-1.5 rounded tabular-nums">0</span>
          `;
        }

        // Global Safe Mode Toggle
        const smBtn = document.getElementById('safe-mode-toggle');
        const smBanner = document.getElementById('safe-mode-banner');
        if (this.state.safeMode) {
          smBtn.className = 'inline-flex items-center gap-2 px-2.5 py-1.5 rounded border border-amber-400 bg-amber-100 text-amber-950 text-[12px] font-medium transition-colors';
          smBtn.innerHTML = `
